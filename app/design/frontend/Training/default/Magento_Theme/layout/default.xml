<?xml version="1.0"?>
<!--
/**
 * 2xlhome-style header on every page: black promo bar, logo / search / icons row,
 * and a flat category bar (no dropdowns).
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Black promo bar (editable in Content > Blocks > header_promo_bar) -->
        <referenceContainer name="header.panel">
            <block class="Magento\Cms\Block\Block" name="thdr.promo" before="-">
                <arguments>
                    <argument name="block_id" xsi:type="string">header_promo_bar</argument>
                </arguments>
            </block>
        </referenceContainer>

        <!-- Logo size (tall wordmark, like 2xl) -->
        <referenceBlock name="logo">
            <arguments>
                <argument name="logo_width" xsi:type="number">58</argument>
                <argument name="logo_height" xsi:type="number">80</argument>
            </arguments>
        </referenceBlock>

        <!-- Globe / account / store-locator icons next to the mini cart -->
        <referenceContainer name="header-wrapper">
            <block class="Magento\Framework\View\Element\Template" name="thdr.icons" template="Magento_Theme::html/header-icons.phtml" after="minicart"/>
        </referenceContainer>

        <referenceBlock name="catalog.compare.link" remove="true"/>

        <!-- Footer: 4 link columns + newsletter in one row, then social icons, popular searches -->
        <referenceContainer name="footer">
            <container name="tftr.grid" htmlTag="div" htmlClass="tftr-grid" before="-">
                <block class="Magento\Cms\Block\Block" name="tftr.columns">
                    <arguments>
                        <argument name="block_id" xsi:type="string">footer_columns</argument>
                    </arguments>
                </block>
                <container name="tftr.newsletter" htmlTag="div" htmlClass="tftr-col tftr-col--newsletter" after="tftr.columns">
                    <block class="Magento\Framework\View\Element\Template" name="tftr.newsletter.heading" template="Magento_Theme::html/footer-heading.phtml">
                        <arguments>
                            <argument name="heading" xsi:type="string" translate="true">Sign Up for Newsletter</argument>
                        </arguments>
                    </block>
                </container>
            </container>
            <block class="Magento\Cms\Block\Block" name="tftr.social" after="tftr.grid">
                <arguments>
                    <argument name="block_id" xsi:type="string">footer_social</argument>
                </arguments>
            </block>
            <block class="Magento\Cms\Block\Block" name="tftr.popular" after="tftr.social">
                <arguments>
                    <argument name="block_id" xsi:type="string">footer_popular_searches</argument>
                </arguments>
            </block>
        </referenceContainer>

        <!-- Magento's own newsletter form becomes the 5th column -->
        <move element="form.subscribe" destination="tftr.newsletter" after="tftr.newsletter.heading"/>
        <referenceBlock name="footer_links" remove="true"/>
    </body>
</page>
