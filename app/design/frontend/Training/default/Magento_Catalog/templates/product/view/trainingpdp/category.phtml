<?php
/**
 * Category name under the product title (current category, else the product's first category).
 *
 * @var \Magento\Catalog\Block\Product\View $block
 * @var \Magento\Framework\Escaper $escaper
 */
$product = $block->getProduct();
$category = $product->getCategory();
if (!$category || !$category->getId()) {
    $category = $product->getCategoryCollection()
        ->addAttributeToSelect('name')
        ->addIsActiveFilter()
        ->setOrder('level', 'DESC')
        ->setOrder('entity_id', 'ASC')
        ->getFirstItem();
}
?>
<?php if ($category && $category->getId()): ?>
    <div class="tpdp-category">
        <a href="<?= $escaper->escapeUrl($category->getUrl()) ?>"><?= $escaper->escapeHtml($category->getName()) ?></a>
    </div>
<?php endif; ?>
