# Sensitive environment configuration
/app/etc/env.php

# Composer dependencies
/vendor/

# Generated Magento code
/generated/

# Generated static files
/pub/static/

# User-uploaded media (product images, image caches)
/pub/media/

# Runtime cache written by pub/get.php
/pub/opt/

# Magento's own internal QA test suite (not project code)
/dev/tests/

# Runtime files and cache
/var/
